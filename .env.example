# ==============================================================================
# Exemple de configuration pour NatachaEye_FERPlus
# Copie ce fichier vers un nouveau fichier nommé '.env' et adapte les valeurs
# ==============================================================================

# Configuration MQTT
MQTT_BROKER=localhost
MQTT_PORT=1883
MQTT_TOPIC=natacha/oeil_detection

# Paramètres de vision
YOLO_CONFIDENCE=0.45

# Paramètres d'exécution
ANALYSE_EMOTION=True
AFFICHAGE_GRAPHIQUE=False
